<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests run on net10.0 everywhere. On Windows they also run on net481,
    which consumes the library's netstandard2.0 build: that run is the proof
    of the netstandard2.0 floor. Every other platform builds and runs
    net10.0 alone, because .NET Framework runs only on Windows.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net481</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Riddler.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Coverage is measured on net10.0; coverlet.MTP runs on .NET 8 and later only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Riddler.Uxid/Riddler.Uxid.csproj" />
  </ItemGroup>

</Project>
