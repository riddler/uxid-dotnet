<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>Riddler.Uxid</AssemblyName>
    <RootNamespace>Riddler</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Riddler.Uxid</PackageId>
    <Authors>John Thornton</Authors>
    <Copyright>Copyright (c) 2026 John Thornton</Copyright>
    <Description>Prefixed, K-sortable identifiers a person can read: random, deterministic and monotonic generation, decoding and validity checks. Follows the uxid wire format and passes its conformance corpus. No dependencies; netstandard2.0 and net10.0.</Description>
    <PackageTags>uxid;id;identifier;sortable;prefixed</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/riddler/uxid-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/riddler/uxid-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
