<?xml version="1.0" encoding="utf-8"?>
<!--
  The only package source is nuget.org. The clear element drops any source a
  machine-wide or user-level configuration adds, so a restore resolves the
  same packages on every machine and in CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
